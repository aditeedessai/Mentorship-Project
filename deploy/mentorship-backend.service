[Unit]
Description=Mentorship Project backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/venv/bin/uvicorn backend.api.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
